<?xml version="1.0"?>
<ruleset name="VL JWT Auth">
    <description>WordPress Coding Standards for the VL JWT Auth plugin.</description>

    <file>vl-jwt-auth.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>

    <config name="minimum_supported_wp_version" value="6.4"/>
    <config name="testVersion" value="8.4-"/>

    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="WordPress-Extra">
        <!-- PSR-4 dictates one class per file; file-name rules conflict with that. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Short array syntax is standard across the project. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="vl-jwt-auth"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="vl_jwt_auth"/>
                <element value="VL_JWT_AUTH"/>
                <element value="VLJwtAuth"/>
            </property>
        </properties>
    </rule>
</ruleset>