includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - src
        - vl-lms.php
        - uninstall.php
    bootstrapFiles:
        - tests/bootstrap.php
    # Make sibling vl-jwt-auth's symbols discoverable without analysing them —
    # vl-lms depends on the \VLJwtAuth facade at runtime (see
    # PHASE-2-AUDIT.md) and directly consumes a handful of its services until
    # the facade gains a token-issuance method.
    scanDirectories:
        - ../vl-jwt-auth/src
    excludePaths:
        - vendor
    # apply_filters / get_post_meta / get_user_meta runtime can legitimately
    # diverge from their docblocked return types — third-party filters and
    # mismatched stored meta both return values outside the declared shape.
    # Keep PHPStan 2.x's pre-2.0 behaviour so defensive is_array() / instanceof
    # guards are not reported as dead code.
    treatPhpDocTypesAsCertain: false
